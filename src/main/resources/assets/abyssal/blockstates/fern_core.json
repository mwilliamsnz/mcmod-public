{
  "multipart": [
    {
      "apply": {
        "model": "abyssal:block/fern_core"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "abyssal:block/fern_frond"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "abyssal:block/fern_frond",
        "y": 270
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "abyssal:block/fern_frond",
        "y": 180
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "abyssal:block/fern_frond",
        "y": 90
      }
    }
  ]
}